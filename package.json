{
  "name": "opencode-openai-limits-local",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.tsx",
    "./rpc": "./src/rpc.ts"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs && python3 -m unittest discover -s test -p 'test_*.py'",
    "typecheck": "tsc --noEmit",
    "security:scan": "python3 scripts/secret_scan.py --history HEAD",
    "security:hooks": "git config --local core.hooksPath .githooks"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.5"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.6.6",
    "@opentui/solid": ">=0.6.6",
    "solid-js": ">=1.9.0"
  }
}
